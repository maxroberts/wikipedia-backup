# Machine-specific settings. Copy to .env (not committed) and edit.
# Nothing reads this file yet: config.py arrives in Stage 2.

# Archive (HDD): every kept version, partial downloads, manifest.json and logs.
# Must never be inside the Dropbox folder.
DATA_DIR=/Volumes/Starfish_Prime/kiwix-data

# Hot copy (SSD): a verified copy of the newest version only. Served in preference to the
# archive copy. Must be outside the Dropbox folder. Leave empty to turn the hot copy off.
HOT_DIR=/Volumes/BackUp_T7/kiwix-hot

# Generated library.xml for kiwix-serve. On the internal disk, so serving works when either
# external drive is missing.
STATE_DIR=~/.local/state/wikibackup

# kiwix-serve --address. "all" listens on every interface so LAN devices can connect.
BIND_ADDRESS=all

# kiwix-serve --port. kiwix-serve's own default is 80; 8080 was free on 2026-11-23.
PORT=8080

LOG_LEVEL=INFO
